<div class="articles-container">
  <h1 class="articles-header">All Articles</h1>

  <% if user_signed_in? %>
    <%= link_to "New Article", new_article_path, class: "articles-new-link" %>
  <% end %>

  <div class="articles-list">
    <% @articles.each do |article| %>
      <article class="article-card">
        <h2 class="article-title"><%= link_to article.title, article_path(article), class: "article-link" %></h2>
        
        <p class="article-excerpt"><%= truncate(article.content, length: 100) %></p>

        <% if article.image.present? %>
          <div class="article-image">
            <%= image_tag article.image.url, alt: article.title, class: "article-image__img" %>
          </div>
        <% end %>

        <div class="article-meta">
          <span class="article-author">By: <%= article.user.email %></span>
          <span class="article-reports">Reports: <%= article.reports_count || 0 %></span>
        </div>

        <% if user_signed_in? && article.user != current_user %>
          <%= button_to "Report", report_article_path(article), method: :patch, 
              class: "article-report-button",
              data: { confirm: "Are you sure you want to report this article?" } %>
        <% end %>
      </article>
    <% end %>
  </div>
</div>