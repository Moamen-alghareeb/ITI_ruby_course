<div class="article-show">
  <h1 class="article-show__title"><%= @article.title %></h1>

  <div class="article-show__content">
    <%= simple_format(@article.content) %>
  </div>

  <% if @article.image.present? %>
    <div class="article-show__image">
      <%= image_tag @article.image.url, alt: @article.title, class: "article-show__image-img" %>
    </div>
  <% end %>

  <div class="article-show__meta">
    <p class="article-show__author">Written by: <%= @article.user.email %></p>
    <p class="article-show__reports">Reports: <%= @article.reports_count || 0 %></p>
  </div>

  <% if user_signed_in? && @article.user == current_user %>
    <div class="article-show__actions">
      <%= link_to "Edit", edit_article_path(@article), class: "article-show__edit-link" %>
      <%= link_to "Delete", @article, method: :delete, 
          class: "article-show__delete-link",
          data: { confirm: "Are you sure you want to delete this article?" } %>
    </div>
  <% end %>

  <div class="article-show__back">
    <%= link_to "Back to Articles", articles_path, class: "article-show__back-link" %>
  </div>
</div>
