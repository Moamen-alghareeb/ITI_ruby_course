<%= form_with model: product, class: "product-form" do |form| %>
  <div class="form-field">
    <%= form.label :name, "Product Name", class: "form-label" %>
    <%= form.text_field :name, class: "form-input", placeholder: "Enter product name" %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "btn btn-submit" %>
  </div>
<% end %>